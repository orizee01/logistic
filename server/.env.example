NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://localhost:5432/logistic

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Origin of the React app; used for CORS and for activation links.
CLIENT_URL=http://localhost:5173

# Max auth requests (login/activation) per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20

# Development only: show activation links on screen while email is in console mode (no SMTP_PASS).
# Hidden automatically once real email is configured, and always ignored when NODE_ENV=production.
DEV_SHOW_ACTIVATION_LINKS=true

# Optional: creates/updates an admin account when running `npm run db:seed`.
# Choose a strong, unique password. It is hashed before being stored.
SEED_ADMIN_NAME=Operations Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Email (SMTP). Leave SMTP_HOST empty to print emails to the console instead.
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#         SMTP_USER=you@gmail.com   SMTP_PASS=<16-character App Password, not your Gmail password>
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=resend  SMTP_PASS=<API key>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients. For Gmail this must be your Gmail address.
MAIL_FROM=SwiftDrop <you@gmail.com>
# Time zone for times shown in emails (IANA name).
MAIL_TIMEZONE=Africa/Lagos
